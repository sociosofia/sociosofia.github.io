{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sociosofia.github.io/schemas/card-dados-publico-v1.schema.json",
  "title": "Card público de dados — Sociosofia v1",
  "type": "object",
  "required": [
    "versao_contrato",
    "modelo_publico",
    "id",
    "codigo_publicacao",
    "evi_id",
    "tema_ids",
    "titulo",
    "dado",
    "contextualizacao",
    "interpretacao_sociosofia",
    "fonte_nome",
    "fonte_url",
    "ano_data",
    "status",
    "aprovacao"
  ],
  "properties": {
    "versao_contrato": {"const": "1.0"},
    "modelo_publico": {"const": "card_dados_v1"},
    "id": {"type": "string", "pattern": "^DAD-[0-9]{4}$"},
    "codigo_publicacao": {"type": "string", "pattern": "^R[0-9]{3}-C[0-9]{2}$"},
    "evi_id": {"type": "string", "pattern": "^EVI-[A-Za-z0-9][A-Za-z0-9-]*$"},
    "tema_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "editoria": {"type": "string"},
    "categoria": {"type": "string"},
    "subtema": {"type": "string"},
    "titulo": {"type": "string", "minLength": 1},
    "subtitulo": {"type": "string"},
    "tipo": {"type": "string"},
    "resumo": {"type": "string"},
    "dado": {"type": "string", "minLength": 1},
    "contextualizacao": {"type": "string", "minLength": 1},
    "interpretacao_sociosofia": {"type": "string", "minLength": 1},
    "questao": {"type": "string"},
    "conexoes": {"type": "string"},
    "conceitos": {"type": "array", "items": {"type": "string"}},
    "autores": {"type": "array", "items": {"type": "string"}},
    "fonte_nome": {"type": "string", "minLength": 1},
    "fonte_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "ano_data": {"type": "string", "minLength": 1},
    "confiabilidade": {"type": "string"},
    "fonte_status": {"type": "string"},
    "nivel": {"type": "string"},
    "status": {"const": "publicado"},
    "aprovacao": {
      "type": "object",
      "required": ["status", "aprovado_por"],
      "properties": {
        "status": {"const": "aprovado"},
        "aprovado_por": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "destaque": {"type": "boolean"},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
