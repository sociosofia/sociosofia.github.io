{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sociosofia.github.io/schemas/card-repertorio-publico-v1.schema.json",
  "title": "Card público de repertório cultural — Sociosofia v1",
  "type": "object",
  "required": [
    "versao_contrato",
    "modelo_publico",
    "id",
    "tema_ids",
    "titulo",
    "tipo",
    "resumo_obra",
    "leitura_sociosofia",
    "fonte_nome",
    "fonte_url",
    "ano_data",
    "status",
    "aprovacao"
  ],
  "properties": {
    "versao_contrato": {"const": "1.0"},
    "modelo_publico": {"const": "card_repertorio_v1"},
    "id": {"type": "string", "pattern": "^CUL-[0-9]{4}$"},
    "tema_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "editoria": {"type": "string"},
    "categoria": {"type": "string"},
    "subtema": {"type": "string"},
    "titulo": {"type": "string", "minLength": 1},
    "subtitulo": {"type": "string"},
    "tipo": {"type": "string", "minLength": 1},
    "resumo": {"type": "string"},
    "resumo_obra": {"type": "string", "minLength": 1},
    "leitura_sociosofia": {"type": "string", "minLength": 1},
    "ancoragem_teorica": {"type": "string"},
    "conceitos": {"type": "array", "items": {"type": "string"}},
    "autores": {"type": "array", "items": {"type": "string"}},
    "autores_possiveis": {"type": "array", "items": {"type": "string"}},
    "relacoes_pendentes": {"type": "array", "items": {"type": "string"}},
    "fonte_nome": {"type": "string", "minLength": 1},
    "fonte_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "ano_data": {"type": "string", "minLength": 1},
    "confiabilidade": {"type": "string"},
    "fonte_status": {"type": "string"},
    "nivel": {"type": "string"},
    "status": {"const": "publicado"},
    "aprovacao": {
      "type": "object",
      "required": ["status", "aprovado_por"],
      "properties": {
        "status": {"const": "aprovado"},
        "aprovado_por": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "destaque": {"type": "boolean"},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
