{"renderHtml":"\r\n\r\n\r\n    \u003cdl class=\"dl-horizontal\"\u003e\r\n\r\n        \u003cdt style=\"break-after:avoid\"\u003e\r\n            Arquivos Eletrônicos\r\n        \u003c/dt\u003e\r\n\r\n        \u003cdd class=\"text-justify\" style=\"break-before:avoid\"\u003e\r\n\r\n            \u003cdiv class=\"alert alert-warning\" style=\"font-size: 18px;\"\u003e\r\n                \u003cstrong\u003eAtenção!\u003c/strong\u003e A contagem de prazos processuais é regida pelos artigos 119 e 120 do Regimento Interno do TCMSP. Não se inicia com a visualização de peças do processo\r\n            \u003c/div\u003e\r\n\r\n\r\n            \u003cdiv Class=\"table-responsive\"\u003e\r\n                \u003cTable Class=\"table table-hover table-striped sortable\" style=\"font-size:12px\"\u003e\r\n                    \u003cthead\u003e\r\n                        \u003ctr\u003e\r\n                            \u003cth\u003e#\u003c/th\u003e\r\n                            \u003cth style=\"min-width: 100px;\"\u003e Arquivo\u003c/th\u003e\r\n                            \u003cth\u003e nº/ano Ato\u003c/th\u003e\r\n                            \u003cth\u003e Area\u003c/th\u003e\r\n                            \u003cth\u003e Sigla Documento\u003c/th\u003e\r\n                            \u003cth\u003e Tipo Documento\u003c/th\u003e\r\n                            \u003cth\u003e Data arquivo\u003c/th\u003e\r\n                        \u003c/tr\u003e\r\n                    \u003c/thead\u003e\r\n\r\n                    \u003ctbody\u003e\r\n\r\n                            \u003ctr\u003e\r\n\r\n\r\n                                \u003ctd\u003e\r\n                                    1\r\n                                \u003c/td\u003e\r\n\r\n                                \u003ctd\u003e\r\n                                            \u003ca href=\"\\ConsultaProcesso\\DocumentoEtcm?nuProcesso=TC0031532023\u0026amp;codArquivoDigital=1945272\" title=\"Ver arquivo\" target=\"_blank\"\u003e\r\n\r\n\r\n\r\